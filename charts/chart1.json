{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "background": null,
    "title": {
        "text": "How Have Language Enrolments Changed Since 2012?",
        "subtitle": "Select a school level and language to explore enrolment trends."
    },
    "width": "container",
    "height": 400,
    "data": {
        "url": "data/nsw_language_analysis_ready.csv",
        "format": {
            "type": "csv",
            "parse": {
                "year": "number",
                "enrolments": "number"
            }
        }
    },
    "params": [
        {
            "name": "school_selection",
            "value": "Secondary (Years 7–9)",
            "bind": {
                "input": "select",
                "options": [
                    "Primary",
                    "Secondary (Years 7–9)"
                ],
                "name": "School Level: "
            }
        },
        {
            "name": "language_selection",
            "value": "All Languages",
            "bind": {
                "input": "select",
                "options": [
                    "All Languages",
                    "Japanese",
                    "French",
                    "Chinese (Mandarin)",
                    "Italian",
                    "Spanish"
                ],
                "name": "Select Language: "
            }
        }
    ],
    "transform": [
        {
            "filter": "datum.school_level === school_selection"
        },
        {
            "filter": {
                "field": "language",
                "oneOf": [
                    "Japanese",
                    "French",
                    "Chinese (Mandarin)",
                    "Italian",
                    "Spanish"
                ]
            }
        },
        {
            "window": [
                {
                    "op": "first_value",
                    "field": "enrolments",
                    "as": "baseline"
                }
            ],
            "sort": [
                {
                    "field": "year",
                    "order": "ascending"
                }
            ],
            "groupby": [
                "school_level",
                "language"
            ]
        },
        {
            "calculate": "datum.enrolments - datum.baseline",
            "as": "change"
        },
        {
            "calculate": "datum.baseline > 0 ? 100 * datum.change / datum.baseline : null",
            "as": "pct_change"
        },
        {
            "filter": "language_selection === 'All Languages' || datum.language === language_selection"
        }
    ],
    "mark": {
        "type": "line",
        "point": {
            "filled": true,
            "size": 35
        },
        "strokeWidth": 2.5
    },
    "encoding": {
        "x": {
        "field": "year",
        "type": "quantitative",
        "title": "Year",
        "scale": {
            "domain": [2012, 2024],
            "nice": false
        },
        "axis": {
            "values": [
                2012,
                2013,
                2014,
                2015,
                2016,
                2017,
                2018,
                2019,
                2020,
                2021,
                2022,
                2023,
                2024
            ],
            "format": "d",
            "labelAngle": 0,
            "labelOverlap": true
        }
    },
        "y": {
            "field": "enrolments",
            "type": "quantitative",
            "title": "Number of enrolments",
            "scale": {
                "zero": true
            }
        },
        "color": {
            "field": "language",
            "type": "nominal",
            "title": "Language",
            "scale": {
                "domain": [
                    "Japanese",
                    "French",
                    "Chinese (Mandarin)",
                    "Italian",
                    "Spanish"
                ],
                "range": [
                    "#D55E00",
                    "#009E73",
                    "#0072B2",
                    "#555555",
                    "#CC79A7"
                ]
            }
        },
        "tooltip": [
            {
                "field": "year",
                "type": "ordinal",
                "title": "Year"
            },
            {
                "field": "school_level",
                "type": "nominal",
                "title": "School level"
            },
            {
                "field": "language",
                "type": "nominal",
                "title": "Language"
            },
            {
                "field": "enrolments",
                "type": "quantitative",
                "title": "Enrolments",
                "format": ","
            },
            {
                "field": "baseline",
                "type": "quantitative",
                "title": "2012 enrolments",
                "format": ","
            },
            {
                "field": "change",
                "type": "quantitative",
                "title": "Change since 2012",
                "format": "+,"
            },
            {
                "field": "pct_change",
                "type": "quantitative",
                "title": "Change since 2012 (%)",
                "format": "+.1f"
            }
        ]
    },
    "config": {
        "view": {
            "fill": null,
            "stroke": null
        },
        "legend": {
            "orient": "bottom",
            "symbolType": "stroke",
            "labelFontSize": 12
        },
        "axis": {
            "labelColor": "#243B35",
            "titleColor": "#243B35"
        }
    }
}