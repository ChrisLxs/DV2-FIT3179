{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "background": null,
    "title": {
        "text": "Language Enrolments Relative to Historical Average (2012–2024)",
        "fontSize": 16,
        "fontWeight": 600,
        "color": "#5C6861",
        "anchor": "start",
        "offset": 15
    },
    "width": 750,
    "height": 400,
    "data": {
        "url": "data/nsw_language_analysis_ready.csv",
        "format": {
            "type": "csv",
            "parse": {
                "year": "number",
                "enrolments": "number"
            }
        }
    },
    "params": [
        {
            "name": "school_selection",
            "value": "Secondary (Years 7–9)",
            "bind": {
                "input": "select",
                "options": [
                    "Primary",
                    "Secondary (Years 7–9)"
                ],
                "name": "School Level: "
            }
        }
    ],
    "transform": [
        {
            "filter": "datum.school_level === school_selection"
        },
        {
            "filter": {
                "field": "language",
                "oneOf": [
                    "Japanese",
                    "French",
                    "Chinese (Mandarin)",
                    "Italian",
                    "Spanish",
                    "Arabic"
                ]
            }
        },
        {
            "aggregate": [
                {
                    "op": "sum",
                    "field": "enrolments",
                    "as": "annual_enrolments"
                }
            ],
            "groupby": [
                "year",
                "language"
            ]
        },
        {
            "joinaggregate": [
                {
                    "op": "mean",
                    "field": "annual_enrolments",
                    "as": "historical_average"
                }
            ],
            "groupby": [
                "language"
            ]
        },
        {
            "filter": "datum.historical_average > 0"
        },
        {
            "calculate": "((datum.annual_enrolments - datum.historical_average) / datum.historical_average) * 100",
            "as": "difference_percent"
        }
    ],
    "mark": {
        "type": "rect",
        "stroke": "#FFFFFF",
        "strokeWidth": 2
    },
    "encoding": {
        "x": {
            "field": "year",
            "type": "ordinal",
            "title": "Year",
            "sort": "ascending",
            "axis": {
                "labelAngle": 0,
                "labelColor": "#5C6861",
                "titleColor": "#5C6861",
                "labelFontSize": 11,
                "titleFontSize": 12
            }
        },
        "y": {
            "field": "language",
            "type": "nominal",
            "title": "Language",
            "sort": [
                "Japanese",
                "French",
                "Chinese (Mandarin)",
                "Italian",
                "Spanish",
                "Arabic"
            ],
            "axis": {
                "labelColor": "#5C6861",
                "titleColor": "#5C6861",
                "labelFontSize": 11,
                "titleFontSize": 12
            }
        },
        "color": {
            "field": "difference_percent",
            "type": "quantitative",
            "title": "Difference from Average (%)",
            "scale": {
                "domainMid": 0,
                "scheme": "redblue",
                "reverse": true
            },
            "legend": {
                "orient": "bottom",
                "direction": "horizontal",
                "gradientLength": 280,
                "gradientThickness": 14,
                "titleFontSize": 12,
                "labelFontSize": 11,
                "titleColor": "#5C6861",
                "labelColor": "#5C6861",
                "offset": 16
            }
        },
        "tooltip": [
            {
                "field": "language",
                "type": "nominal",
                "title": "Language"
            },
            {
                "field": "year",
                "type": "ordinal",
                "title": "Year"
            },
            {
                "field": "annual_enrolments",
                "type": "quantitative",
                "title": "Annual Enrolments",
                "format": ",.0f"
            },
            {
                "field": "historical_average",
                "type": "quantitative",
                "title": "Historical Average",
                "format": ",.0f"
            },
            {
                "field": "difference_percent",
                "type": "quantitative",
                "title": "Difference from Average (%)",
                "format": "+.1f"
            }
        ]
    },
    "config": {
        "view": {
            "fill": null,
            "stroke": null
        },
        "axis": {
            "labelFontSize": 11,
            "titleFontSize": 12,
            "labelColor": "#5C6861",
            "titleColor": "#5C6861"
        },
        "legend": {
            "labelColor": "#5C6861",
            "titleColor": "#5C6861"
        }
    }
}