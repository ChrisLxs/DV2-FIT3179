{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "background": null,
    "title": {
        "text": "Largest Language Enrolment Gaps (2024)",
        "subtitle": "Positive = more primary enrolments | Negative = more secondary enrolments",
        "fontSize": 16,
        "fontWeight": 600,
        "color": "#5C6861",
        "subtitleColor": "#5C6861",
        "subtitleFontSize": 12,
        "anchor": "start",
        "offset": 18
    },
    "width": 520,
    "height": 460,
    "data": {
        "url": "data/nsw_language_analysis_ready.csv",
        "format": {
            "type": "csv",
            "parse": {
                "year": "number",
                "enrolments": "number"
            }
        }
    },
    "transform": [
        {
            "filter": "datum.year === 2024"
        },
        {
            "aggregate": [
                {
                    "op": "sum",
                    "field": "enrolments",
                    "as": "total_enrolments"
                }
            ],
            "groupby": [
                "language",
                "school_level"
            ]
        },
        {
            "pivot": "school_level",
            "value": "total_enrolments",
            "groupby": [
                "language"
            ]
        },
        {
            "filter": "isValid(datum['Primary']) && isValid(datum['Secondary (Years 7–9)'])"
        },
        {
            "calculate": "datum['Primary'] - datum['Secondary (Years 7–9)']",
            "as": "enrolment_gap"
        },
        {
            "calculate": "abs(datum.enrolment_gap)",
            "as": "absolute_gap"
        },
        {
            "calculate": "datum.enrolment_gap >= 0 ? 'More Primary Enrolments' : 'More Secondary Enrolments'",
            "as": "gap_direction"
        },
        {
            "window": [
                {
                    "op": "row_number",
                    "as": "gap_rank"
                }
            ],
            "sort": [
                {
                    "field": "absolute_gap",
                    "order": "descending"
                },
                {
                    "field": "language",
                    "order": "ascending"
                }
            ]
        },
        {
            "filter": "datum.gap_rank <= 12"
        }
    ],
    "encoding": {
        "y": {
            "field": "language",
            "type": "nominal",
            "title": null,
            "sort": {
                "field": "gap_rank",
                "order": "ascending"
            },
            "axis": {
                "labelLimit": 230,
                "labelFontSize": 11,
                "labelPadding": 8,
                "labelColor": "#5C6861",
                "minExtent": 185
            }
        },
        "x": {
            "field": "enrolment_gap",
            "type": "quantitative",
            "title": "Difference in Recorded Enrolments (Primary − Secondary)",
            "scale": {
                "zero": true,
                "nice": true
            },
            "axis": {
                "format": ",.0f",
                "labelFontSize": 11,
                "titleFontSize": 12,
                "labelColor": "#5C6861",
                "titleColor": "#5C6861",
                "labelPadding": 8,
                "labelOverlap": false,
                "grid": true,
                "gridColor": "#E5DDD0",
                "gridOpacity": 0.6,
                "tickCount": 7
            }
        },
        "color": {
            "field": "gap_direction",
            "type": "nominal",
            "title": null,
            "scale": {
                "domain": [
                    "More Primary Enrolments",
                    "More Secondary Enrolments"
                ],
                "range": [
                    "#0072B2",
                    "#D55E00"
                ]
            },
            "legend": {
                "orient": "bottom",
                "direction": "horizontal",
                "labelFontSize": 11,
                "symbolSize": 120,
                "offset": 14
            }
        },
        "tooltip": [
            {
                "field": "language",
                "type": "nominal",
                "title": "Language"
            },
            {
                "field": "Primary",
                "type": "quantitative",
                "title": "Primary Enrolments",
                "format": ",.0f"
            },
            {
                "field": "Secondary (Years 7–9)",
                "type": "quantitative",
                "title": "Secondary Enrolments",
                "format": ",.0f"
            },
            {
                "field": "enrolment_gap",
                "type": "quantitative",
                "title": "Primary − Secondary",
                "format": "+,.0f"
            }
        ]
    },
    "layer": [
        {
            "mark": {
                "type": "rule",
                "color": "#5C6861",
                "strokeDash": [
                    4,
                    4
                ],
                "strokeWidth": 1.5
            },
            "encoding": {
                "x": {
                    "datum": 0
                },
                "color": {
                    "value": "#5C6861"
                }
            }
        },
        {
            "mark": {
                "type": "rule",
                "strokeWidth": 2.5
            },
            "encoding": {
                "x": {
                    "datum": 0
                },
                "x2": {
                    "field": "enrolment_gap"
                }
            }
        },
        {
            "mark": {
                "type": "point",
                "filled": true,
                "size": 150,
                "stroke": "#FFFFFF",
                "strokeWidth": 1
            }
        }
    ],
    "config": {
        "view": {
            "fill": null,
            "stroke": null
        },
        "axis": {
            "labelColor": "#5C6861",
            "titleColor": "#5C6861",
            "domainColor": "#5C6861",
            "tickColor": "#5C6861",
            "gridColor": "#E5DDD0",
            "gridOpacity": 0.6
        },
        "legend": {
            "labelColor": "#5C6861",
            "titleColor": "#5C6861"
        }
    }
}