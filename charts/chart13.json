{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "background": null,
    "title": {
        "text": "Geographic Distribution of NSW Government Schools (2026)",
        "subtitle": "School locations by type · Geographic context, not language-specific enrolments",
        "fontSize": 16,
        "fontWeight": 600,
        "color": "#5C6861",
        "subtitleColor": "#5C6861",
        "subtitleFontSize": 12,
        "anchor": "start",
        "offset": 18
    },
    "width": 600,
    "height": 560,
    "projection": {
        "type": "mercator",
        "center": [
            147.5,
            -33.0
        ],
        "scale": 2100
    },
    "params": [
        {
            "name": "school_type_selection",
            "value": "All Schools",
            "bind": {
                "input": "select",
                "options": [
                    "All Schools",
                    "Primary School",
                    "Secondary School",
                    "Central/Community School",
                    "Schools for Specific Purposes",
                    "Environmental Education Centre",
                    "Infants School",
                    "Other School"
                ],
                "name": "School Type: "
            }
        }
    ],
    "layer": [
        {
            "data": {
                "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
                "format": {
                    "type": "topojson",
                    "feature": "countries"
                }
            },
            "mark": {
                "type": "geoshape",
                "fill": "#F3F1EA",
                "stroke": "#B8C2BC",
                "strokeWidth": 0.8
            }
        },
        {
            "data": {
                "url": "data/nsw_schools_locations.csv",
                "format": {
                    "type": "csv",
                    "parse": {
                        "Latitude": "number",
                        "Longitude": "number",
                        "latest_year_enrolment_FTE": "number"
                    }
                }
            },
            "transform": [
                {
                    "filter": "school_type_selection === 'All Schools' || datum.Level_of_schooling === school_type_selection"
                },
                {
                    "filter": "isValid(datum.Latitude) && isValid(datum.Longitude)"
                },
                {
                    "filter": "datum.Latitude >= -38 && datum.Latitude <= -28 && datum.Longitude >= 140 && datum.Longitude <= 154"
                }
            ],
            "mark": {
                "type": "circle",
                "size": 25,
                "opacity": 0.6,
                "stroke": "#FFFFFF",
                "strokeWidth": 0.3
            },
            "encoding": {
                "longitude": {
                    "field": "Longitude",
                    "type": "quantitative"
                },
                "latitude": {
                    "field": "Latitude",
                    "type": "quantitative"
                },
                "color": {
                    "field": "Level_of_schooling",
                    "type": "nominal",
                    "title": "School Type",
                    "scale": {
                        "domain": [
                            "Primary School",
                            "Secondary School",
                            "Central/Community School",
                            "Schools for Specific Purposes",
                            "Environmental Education Centre",
                            "Infants School",
                            "Other School"
                        ],
                        "range": [
                            "#0072B2",
                            "#D55E00",
                            "#009E73",
                            "#CC79A7",
                            "#56B4E9",
                            "#E69F00",
                            "#7A8680"
                        ]
                    },
                    "legend": {
                        "title": "School Type",
                        "orient": "bottom",
                        "direction": "horizontal",
                        "columns": 3,
                        "labelFontSize": 11,
                        "titleFontSize": 12,
                        "labelColor": "#5C6861",
                        "titleColor": "#5C6861",
                        "labelLimit": 230,
                        "symbolSize": 100,
                        "offset": 16
                    }
                },
                "tooltip": [
                    {
                        "field": "School_name",
                        "type": "nominal",
                        "title": "School"
                    },
                    {
                        "field": "Level_of_schooling",
                        "type": "nominal",
                        "title": "School Type"
                    },
                    {
                        "field": "Town_suburb",
                        "type": "nominal",
                        "title": "Suburb"
                    },
                    {
                        "field": "LGA",
                        "type": "nominal",
                        "title": "Local Government Area"
                    },
                    {
                        "field": "latest_year_enrolment_FTE",
                        "type": "quantitative",
                        "title": "Latest Enrolment (FTE)",
                        "format": ",.0f"
                    }
                ]
            }
        }
    ],
    "config": {
        "view": {
            "fill": null,
            "stroke": null
        },
        "axis": {
            "labelColor": "#5C6861",
            "titleColor": "#5C6861"
        },
        "legend": {
            "labelColor": "#5C6861",
            "titleColor": "#5C6861",
            "labelFontSize": 11,
            "titleFontSize": 12
        }
    }
}