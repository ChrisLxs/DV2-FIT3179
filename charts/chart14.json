{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "background": null,
    "title": {
        "text": "Government School Counts by NSW Local Government Area",
        "subtitle": "Bubble size represents the number of schools in each LGA (2026)",
        "fontSize": 16,
        "fontWeight": 600,
        "color": "#5C6861",
        "subtitleColor": "#5C6861",
        "subtitleFontSize": 12,
        "anchor": "start",
        "offset": 18
    },
    "width": 600,
    "height": 560,
    "projection": {
        "type": "mercator",
        "center": [
            147.5,
            -33.0
        ],
        "scale": 2100
    },
    "params": [
        {
            "name": "school_type_selection",
            "value": "All Schools",
            "bind": {
                "input": "select",
                "options": [
                    "All Schools",
                    "Primary School",
                    "Secondary School",
                    "Central/Community School",
                    "Schools for Specific Purposes",
                    "Environmental Education Centre",
                    "Infants School",
                    "Other School"
                ],
                "name": "School Type: "
            }
        },
        {
            "name": "minimum_schools",
            "value": 1,
            "bind": {
                "input": "range",
                "min": 1,
                "max": 40,
                "step": 1,
                "name": "Minimum Schools per LGA: "
            }
        }
    ],
    "layer": [
        {
            "data": {
                "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
                "format": {
                    "type": "topojson",
                    "feature": "countries"
                }
            },
            "mark": {
                "type": "geoshape",
                "fill": "#F3F1EA",
                "stroke": "#B8C2BC",
                "strokeWidth": 0.8
            }
        },
        {
            "data": {
                "url": "data/nsw_schools_locations.csv",
                "format": {
                    "type": "csv",
                    "parse": {
                        "Latitude": "number",
                        "Longitude": "number"
                    }
                }
            },
            "transform": [
                {
                    "filter": "school_type_selection === 'All Schools' || datum.Level_of_schooling === school_type_selection"
                },
                {
                    "filter": "isValid(datum.Latitude) && isValid(datum.Longitude) && isValid(datum.LGA) && datum.LGA !== ''"
                },
                {
                    "filter": "datum.Latitude >= -38 && datum.Latitude <= -28 && datum.Longitude >= 140 && datum.Longitude <= 154"
                },
                {
                    "aggregate": [
                        {
                            "op": "count",
                            "as": "school_count"
                        },
                        {
                            "op": "mean",
                            "field": "Latitude",
                            "as": "mean_latitude"
                        },
                        {
                            "op": "mean",
                            "field": "Longitude",
                            "as": "mean_longitude"
                        }
                    ],
                    "groupby": [
                        "LGA"
                    ]
                },
                {
                    "filter": "datum.school_count >= minimum_schools"
                }
            ],
            "mark": {
                "type": "circle",
                "opacity": 0.6,
                "color": "#0072B2",
                "stroke": "#FFFFFF",
                "strokeWidth": 0.8
            },
            "encoding": {
                "longitude": {
                    "field": "mean_longitude",
                    "type": "quantitative"
                },
                "latitude": {
                    "field": "mean_latitude",
                    "type": "quantitative"
                },
                "size": {
                    "field": "school_count",
                    "type": "quantitative",
                    "title": "Number of Schools",
                    "scale": {
                        "type": "sqrt",
                        "range": [
                            20,
                            650
                        ]
                    },
                    "legend": {
                        "orient": "bottom",
                        "direction": "horizontal",
                        "titleFontSize": 12,
                        "labelFontSize": 11,
                        "titleColor": "#5C6861",
                        "labelColor": "#5C6861",
                        "offset": 16
                    }
                },
                "tooltip": [
                    {
                        "field": "LGA",
                        "type": "nominal",
                        "title": "Local Government Area"
                    },
                    {
                        "field": "school_count",
                        "type": "quantitative",
                        "title": "Number of Schools",
                        "format": ",.0f"
                    }
                ]
            }
        }
    ],
    "config": {
        "view": {
            "fill": null,
            "stroke": null
        },
        "legend": {
            "labelColor": "#5C6861",
            "titleColor": "#5C6861",
            "labelFontSize": 11,
            "titleFontSize": 12
        }
    }
}