{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "background": null,
    "title": {
        "text": "Government School Counts Across NSW Local Government Areas",
        "fontSize": 16,
        "fontWeight": 600,
        "color": "#5C6861",
        "anchor": "start",
        "offset": 18
    },
    "width": 700,
    "height": 560,
    "data": {
        "url": "data/nsw_lga_school_counts.geojson",
        "format": {
            "type": "json",
            "property": "features"
        }
    },
    "projection": {
        "type": "mercator",
        "center": [147.0, -33.0],
        "scale": 2800,
        "translate": [360, 300]
    },
    "params": [
        {
            "name": "minimum_schools",
            "value": 0,
            "bind": {
                "input": "range",
                "min": 0,
                "max": 50,
                "step": 5,
                "name": "Highlight LGAs with at least: "
            }
        }
    ],
    "transform": [
        {
            "calculate": "datum.properties.school_count",
            "as": "school_count"
        },
        {
            "calculate": "datum.properties.abb_name",
            "as": "lga_name"
        },
        {
            "calculate": "isValid(datum.school_count) && datum.school_count >= minimum_schools",
            "as": "meets_threshold"
        }
    ],
    "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.8
    },
    "encoding": {
        "color": {
            "condition": {
                "test": "datum.meets_threshold",
                "field": "school_count",
                "type": "quantitative",
                "title": "Number of Schools",
                "scale": {
                    "domainMin": 0,
                    "range": [
                        "#EAF3F8",
                        "#B8D9E9",
                        "#75B6D5",
                        "#318DBB",
                        "#0072B2",
                        "#004C78"
                    ]
                },
                "legend": {
                    "orient": "bottom",
                    "direction": "horizontal",
                    "gradientLength": 260,
                    "gradientThickness": 12,
                    "titleFontSize": 12,
                    "labelFontSize": 11,
                    "titleColor": "#5C6861",
                    "labelColor": "#5C6861",
                    "offset": 16
                }
            },
            "value": "#E5E7EB"
        },
        "tooltip": [
            {
                "field": "lga_name",
                "type": "nominal",
                "title": "Local Government Area"
            },
            {
                "field": "school_count",
                "type": "quantitative",
                "title": "Government Schools",
                "format": ",.0f"
            }
        ]
    },
    "config": {
        "view": {
            "fill": null,
            "stroke": null
        },
        "legend": {
            "labelColor": "#5C6861",
            "titleColor": "#5C6861"
        }
    }
}