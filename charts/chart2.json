{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "background": null,
    "data": {
        "url": "data/nsw_language_analysis_ready.csv",
        "format": {
            "type": "csv",
            "parse": {
                "year": "number",
                "enrolments": "number"
            }
        }
    },
    "transform": [
        {
            "filter": "datum.year === 2024"
        },
        {
            "aggregate": [
                {
                    "op": "sum",
                    "field": "enrolments",
                    "as": "count"
                }
            ],
            "groupby": [
                "school_level",
                "language"
            ]
        },
        {
            "window": [
                {
                    "op": "row_number",
                    "as": "rank"
                }
            ],
            "sort": [
                {
                    "field": "count",
                    "order": "descending"
                },
                {
                    "field": "language",
                    "order": "ascending"
                }
            ],
            "groupby": [
                "school_level"
            ]
        },
        {
            "calculate": "datum.rank <= 5 ? datum.language : 'Other'",
            "as": "slice"
        },
        {
            "aggregate": [
                {
                    "op": "sum",
                    "field": "count",
                    "as": "enrolments"
                }
            ],
            "groupby": [
                "school_level",
                "slice"
            ]
        },
        {
            "joinaggregate": [
                {
                    "op": "sum",
                    "field": "enrolments",
                    "as": "total"
                }
            ],
            "groupby": [
                "school_level"
            ]
        },
        {
            "calculate": "datum.enrolments / datum.total",
            "as": "share"
        }
    ],
    "hconcat": [
        {
            "title": "Primary schools",
            "transform": [
                {
                    "filter": "datum.school_level === 'Primary'"
                }
            ],
            "width": 265,
            "height": 270,
            "layer": [
                {
                    "mark": {
                        "type": "arc",
                        "innerRadius": 76,
                        "outerRadius": 118,
                        "stroke": "#FFFCF7",
                        "strokeWidth": 3
                    },
                    "encoding": {
                        "theta": {
                            "field": "enrolments",
                            "type": "quantitative",
                            "stack": true
                        },
                        "color": {
                            "field": "slice",
                            "type": "nominal",
                            "title": null,
                            "scale": {
                                "domain": [
                                    "Chinese (Mandarin)",
                                    "Arabic",
                                    "Italian",
                                    "Vietnamese",
                                    "Dharawal / Tharawal",
                                    "Japanese",
                                    "French",
                                    "Spanish",
                                    "Other"
                                ],
                                "range": [
                                    "#0072B2",
                                    "#E69F00",
                                    "#56B4E9",
                                    "#CC79A7",
                                    "#F0E442",
                                    "#D55E00",
                                    "#009E73",
                                    "#555555",
                                    "#D3D3D3"
                                ]
                            }
                        },
                        "order": {
                            "field": "enrolments",
                            "type": "quantitative",
                            "sort": "descending"
                        },
                        "tooltip": [
                            {
                                "field": "school_level",
                                "type": "nominal",
                                "title": "School Level"
                            },
                            {
                                "field": "slice",
                                "type": "nominal",
                                "title": "Language"
                            },
                            {
                                "field": "enrolments",
                                "type": "quantitative",
                                "format": ",",
                                "title": "Enrolments"
                            },
                            {
                                "field": "share",
                                "type": "quantitative",
                                "format": ".1%",
                                "title": "Share of Language Enrolments"
                            }
                        ]
                    }
                },
                {
                    "transform": [
                        {
                            "filter": "datum.slice === 'Chinese (Mandarin)'"
                        }
                    ],
                    "mark": {
                        "type": "text",
                        "fontSize": 27,
                        "fontWeight": "bold",
                        "color": "#243B35"
                    },
                    "encoding": {
                        "x": {
                            "value": 132.5
                        },
                        "y": {
                            "value": 123
                        },
                        "text": {
                            "field": "share",
                            "type": "quantitative",
                            "format": ".1%"
                        }
                    }
                },
                {
                    "mark": {
                        "type": "text",
                        "fontSize": 12,
                        "fontWeight": "bold",
                        "color": "#315E52"
                    },
                    "encoding": {
                        "x": {
                            "value": 132.5
                        },
                        "y": {
                            "value": 153
                        },
                        "text": {
                            "value": "Mandarin"
                        }
                    }
                }
            ]
        },
        {
            "title": "Secondary · Years 7–9",
            "transform": [
                {
                    "filter": "datum.school_level === 'Secondary (Years 7–9)'"
                }
            ],
            "width": 265,
            "height": 270,
            "layer": [
                {
                    "mark": {
                        "type": "arc",
                        "innerRadius": 76,
                        "outerRadius": 118,
                        "stroke": "#FFFCF7",
                        "strokeWidth": 3
                    },
                    "encoding": {
                        "theta": {
                            "field": "enrolments",
                            "type": "quantitative",
                            "stack": true
                        },
                        "color": {
                            "field": "slice",
                            "type": "nominal",
                            "title": null,
                            "scale": {
                                "domain": [
                                    "Chinese (Mandarin)",
                                    "Arabic",
                                    "Italian",
                                    "Vietnamese",
                                    "Dharawal / Tharawal",
                                    "Japanese",
                                    "French",
                                    "Spanish",
                                    "Other"
                                ],
                                "range": [
                                    "#0072B2",
                                    "#E69F00",
                                    "#56B4E9",
                                    "#CC79A7",
                                    "#F0E442",
                                    "#D55E00",
                                    "#009E73",
                                    "#555555",
                                    "#D3D3D3"
                                ]
                            }
                        },
                        "order": {
                            "field": "enrolments",
                            "type": "quantitative",
                            "sort": "descending"
                        },
                        "tooltip": [
                            {
                                "field": "school_level",
                                "type": "nominal",
                                "title": "School Level"
                            },
                            {
                                "field": "slice",
                                "type": "nominal",
                                "title": "Language"
                            },
                            {
                                "field": "enrolments",
                                "type": "quantitative",
                                "format": ",",
                                "title": "Enrolments"
                            },
                            {
                                "field": "share",
                                "type": "quantitative",
                                "format": ".1%",
                                "title": "Share of Language Enrolments"
                            }
                        ]
                    }
                },
                {
                    "transform": [
                        {
                            "filter": "datum.slice === 'Japanese'"
                        }
                    ],
                    "mark": {
                        "type": "text",
                        "fontSize": 27,
                        "fontWeight": "bold",
                        "color": "#243B35"
                    },
                    "encoding": {
                        "x": {
                            "value": 132.5
                        },
                        "y": {
                            "value": 123
                        },
                        "text": {
                            "field": "share",
                            "type": "quantitative",
                            "format": ".1%"
                        }
                    }
                },
                {
                    "mark": {
                        "type": "text",
                        "fontSize": 12,
                        "fontWeight": "bold",
                        "color": "#315E52"
                    },
                    "encoding": {
                        "x": {
                            "value": 132.5
                        },
                        "y": {
                            "value": 153
                        },
                        "text": {
                            "value": "Japanese"
                        }
                    }
                }
            ]
        }
    ],
    "resolve": {
        "scale": {
            "color": "shared"
        }
    },
    "config": {
        "view": {
            "fill": null,
            "stroke": null
        },
        "legend": {
            "title": null,
            "orient": "bottom",
            "columns": 3,
            "symbolType": "circle",
            "labelFontSize": 11,
            "labelColor": "#5C6861"
        },
        "title": {
            "fontSize": 16,
            "color": "#243B35"
        }
    },
    "spacing": 20
}