{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "background": null,
    "width": 800,
    "height": 450,
    "data": {
        "url": "data/nsw_language_analysis_ready.csv",
        "format": {
            "type": "csv",
            "parse": {
                "year": "number",
                "enrolments": "number"
            }
        }
    },
    "params": [
        {
            "name": "school_selection",
            "value": "Secondary (Years 7–9)",
            "bind": {
                "input": "select",
                "options": [
                    "Primary",
                    "Secondary (Years 7–9)"
                ],
                "name": "School Level: "
            }
        },
        {
            "name": "language_selection",
            "value": "All Languages",
            "bind": {
                "input": "select",
                "options": [
                    "All Languages",
                    "Japanese",
                    "French",
                    "Chinese (Mandarin)",
                    "Italian",
                    "Spanish",
                    "German",
                    "Korean",
                    "Indonesian",
                    "Latin",
                    "Wiradjuri",
                    "Arabic",
                    "Vietnamese",
                    "Greek (Modern)"
                ],
                "name": "Highlight Language: "
            }
        }
    ],              
    "transform": [
        {
            "filter": "datum.school_level === school_selection"
        },
        {
            "aggregate": [
                {
                    "op": "sum",
                    "field": "enrolments",
                    "as": "total_enrolments"
                }
            ],
            "groupby": [
                "year",
                "language"
            ]
        },
        {
            "window": [
                {
                    "op": "row_number",
                    "as": "rank"
                }
            ],
            "sort": [
                {
                    "field": "total_enrolments",
                    "order": "descending"
                },
                {
                    "field": "language",
                    "order": "ascending"
                }
            ],
            "groupby": [
                "year"
            ]
        },
        {
            "filter": "datum.rank <= 10"
        }
    ],
    "encoding": {
        "x": {
            "field": "year",
            "type": "ordinal",
            "title": "Year",
            "sort": "ascending",
            "axis": {
                "labelAngle": 0
            }
        },
        "y": {
            "field": "rank",
            "type": "quantitative",
            "title": "Language Ranking (1 = Highest)",
            "scale": {
                "domain": [
                    1,
                    10
                ],
                "reverse": true,
                "nice": false
            },
            "axis": {
                "tickMinStep": 1,
                "format": "d"
            }
        },
        "color": {
            "field": "language",
            "type": "nominal",
            "title": "Language",
            "scale": {
                "domain": [
                    "Chinese (Mandarin)",
                    "Japanese",
                    "French",
                    "Italian",
                    "Spanish",
                    "Arabic",
                    "Vietnamese",
                    "Korean",
                    "Indonesian",
                    "Greek (Modern)",
                    "German",
                    "Latin",
                    "Wiradjuri"
                ],
                "range": [
                    "#0072B2",
                    "#E69F00",
                    "#9467BD",
                    "#555555",
                    "#CC79A7",
                    "#8C564B",
                    "#17BECF",
                    "#173F6F",
                    "#B79F00",
                    "#56B4E9",
                    "#663399",
                    "#A67C52",
                    "#4D7891"
                ],
                "unknown": "#B8B8B8"
            },
            "legend": {
                "orient": "right",
                "direction": "vertical",
                "columns": 1,
                "title": "Language",
                "titleFontSize": 13,
                "labelFontSize": 12,
                "symbolSize": 130,
                "symbolStrokeWidth": 3,
                "padding": 12,
                "rowPadding": 8,
                "columnPadding": 18
            }
        },
        "detail": {
            "field": "language",
            "type": "nominal"
        },
        "opacity": {
            "condition": {
                "test": "language_selection === 'All Languages' || datum.language === language_selection",
                "value": 1
            },
            "value": 0.12
        },
        "tooltip": [
            {
                "field": "year",
                "type": "ordinal",
                "title": "Year"
            },
            {
                "field": "language",
                "type": "nominal",
                "title": "Language"
            },
            {
                "field": "rank",
                "type": "quantitative",
                "title": "Rank",
                "format": "d"
            },
            {
                "field": "total_enrolments",
                "type": "quantitative",
                "title": "Enrolments",
                "format": ","
            }
        ]
    },
    "layer": [
        {
            "mark": {
                "type": "line",
                "strokeWidth": 3,
                "point": false
            }
        },
        {
            "mark": {
                "type": "point",
                "filled": true,
                "size": 65
            }
        }
    ],
    "config": {
        "view": {
            "fill": null,
            "stroke": null
        },
        "axis": {
            "labelColor": "#243B35",
            "titleColor": "#243B35",
            "gridColor": "#E5E7E2"
        },
        "legend": {
            "labelColor": "#243B35",
            "titleColor": "#243B35"
        }
    }
}