{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "background": null,
    "width": 600,
    "height": 350,
    "data": {
        "url": "data/nsw_language_analysis_ready.csv",
        "format": {
            "type": "csv",
            "parse": {
                "year": "number",
                "enrolments": "number"
            }
        }
    },
    "params": [
        {
            "name": "school_selection",
            "value": "Secondary (Years 7–9)",
            "bind": {
                "input": "select",
                "options": [
                    "Primary",
                    "Secondary (Years 7–9)"
                ],
                "name": "School Level: "
            }
        }
    ],
    "transform": [
        {
            "filter": "datum.school_level === school_selection"
        },
        {
            "aggregate": [
                {
                    "op": "sum",
                    "field": "enrolments",
                    "as": "total_enrolments"
                }
            ],
            "groupby": [
                "year",
                "language"
            ]
        },
        {
            "joinaggregate": [
                {
                    "op": "sum",
                    "field": "total_enrolments",
                    "as": "year_total"
                }
            ],
            "groupby": [
                "year"
            ]
        },
        {
            "calculate": "datum.year_total > 0 ? datum.total_enrolments / datum.year_total : 0",
            "as": "share"
        },
        {
            "calculate": "indexof(['Japanese', 'French', 'Chinese (Mandarin)', 'Italian', 'Spanish'], datum.language) >= 0 ? datum.language : 'Other'",
            "as": "language_group"
        },
        {
            "aggregate": [
                {
                    "op": "sum",
                    "field": "share",
                    "as": "group_share"
                },
                {
                    "op": "sum",
                    "field": "total_enrolments",
                    "as": "group_enrolments"
                }
            ],
            "groupby": [
                "year",
                "language_group"
            ]
        }
    ],
    "mark": {
        "type": "area",
        "interpolate": "linear",
        "opacity": 0.95
    },
    "encoding": {
        "x": {
            "field": "year",
            "type": "ordinal",
            "title": "Year",
            "sort": "ascending",
            "axis": {
                "labelAngle": 0,
                "labelColor": "#243B35",
                "titleColor": "#243B35"
            }
        },
        "y": {
            "field": "group_share",
            "type": "quantitative",
            "title": "Share of Language Enrolments",
            "stack": "zero",
            "scale": {
                "domain": [
                    0,
                    1
                ],
                "nice": false
            },
            "axis": {
                "format": ".0%",
                "tickCount": 6,
                "labelColor": "#243B35",
                "titleColor": "#243B35",
                "gridColor": "#E5E7E2"
            }
        },
        "color": {
            "field": "language_group",
            "type": "nominal",
            "title": "Language",
            "scale": {
                "domain": [
                    "Japanese",
                    "French",
                    "Chinese (Mandarin)",
                    "Italian",
                    "Spanish",
                    "Other"
                ],
                "range": [
                    "#E69F00",
                    "#9467BD",
                    "#0072B2",
                    "#555555",
                    "#CC79A7",
                    "#B8B8B8"
                ]
            },
            "legend": {
                "orient": "right",
                "direction": "vertical",
                "title": "Language",
                "titleFontSize": 13,
                "labelFontSize": 12,
                "symbolSize": 130,
                "padding": 10,
                "rowPadding": 8,
                "offset": 20
            }
        },
        "order": {
            "field": "language_group",
            "type": "nominal",
            "sort": [
                "Japanese",
                "French",
                "Chinese (Mandarin)",
                "Italian",
                "Spanish",
                "Other"
            ]
        },
        "tooltip": [
            {
                "field": "year",
                "type": "ordinal",
                "title": "Year"
            },
            {
                "field": "language_group",
                "type": "nominal",
                "title": "Language"
            },
            {
                "field": "group_enrolments",
                "type": "quantitative",
                "title": "Enrolments",
                "format": ","
            },
            {
                "field": "group_share",
                "type": "quantitative",
                "title": "Share of Enrolments",
                "format": ".1%"
            }
        ]
    },
    "config": {
        "view": {
            "fill": null,
            "stroke": null
        },
        "axis": {
            "labelFontSize": 12,
            "titleFontSize": 13
        },
        "legend": {
            "labelColor": "#243B35",
            "titleColor": "#243B35"
        }
    }
}