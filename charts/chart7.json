{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "background": null,
    "data": {
        "url": "data/nsw_language_analysis_ready.csv",
        "format": {
            "type": "csv",
            "parse": {
                "year": "number",
                "enrolments": "number"
            }
        }
    },
    "params": [
        {
            "name": "school_selection",
            "value": "Secondary (Years 7–9)",
            "bind": {
                "input": "select",
                "options": [
                    "Primary",
                    "Secondary (Years 7–9)"
                ],
                "name": "School Level: "
            }
        }
    ],
    "transform": [
        {
            "filter": "datum.school_level === school_selection"
        },
        {
            "filter": {
                "field": "language",
                "oneOf": [
                    "Japanese",
                    "French",
                    "Chinese (Mandarin)",
                    "Italian",
                    "Spanish",
                    "Arabic"
                ]
            }
        },
        {
            "aggregate": [
                {
                    "op": "sum",
                    "field": "enrolments",
                    "as": "total_enrolments"
                }
            ],
            "groupby": [
                "year",
                "language"
            ]
        }
    ],
    "facet": {
        "field": "language",
        "type": "nominal",
        "title": null,
        "sort": [
            "Japanese",
            "French",
            "Chinese (Mandarin)",
            "Italian",
            "Spanish",
            "Arabic"
        ],
        "header": {
            "labelFontSize": 13,
            "labelFontWeight": "bold",
            "labelColor": "#5C6861"
        }
    },
    "columns": 3,
    "spacing": 18,
    "spec": {
        "width": 190,
        "height": 160,
        "mark": {
            "type": "line",
            "point": {
                "filled": true,
                "size": 35
            },
            "strokeWidth": 2.5
        },
        "encoding": {
            "x": {
                "field": "year",
                "type": "ordinal",
                "title": "Year",
                "sort": "ascending",
                "axis": {
                    "labelAngle": -45,
                    "labelFontSize": 9,
                    "labelColor": "#5C6861",
                    "titleColor": "#5C6861"
                }
            },
            "y": {
                "field": "total_enrolments",
                "type": "quantitative",
                "title": "Enrolments",
                "scale": {
                    "zero": true
                },
                "axis": {
                    "format": "~s",
                    "labelFontSize": 10,
                    "labelColor": "#5C6861",
                    "titleColor": "#5C6861"
                }
            },
            "color": {
                "field": "language",
                "type": "nominal",
                "legend": null,
                "scale": {
                    "domain": [
                        "Japanese",
                        "French",
                        "Chinese (Mandarin)",
                        "Italian",
                        "Spanish",
                        "Arabic"
                    ],
                    "range": [
                        "#E69F00",
                        "#9467BD",
                        "#0072B2",
                        "#555555",
                        "#CC79A7",
                        "#8C564B"
                    ]
                }
            },
            "tooltip": [
                {
                    "field": "language",
                    "type": "nominal",
                    "title": "Language"
                },
                {
                    "field": "year",
                    "type": "ordinal",
                    "title": "Year"
                },
                {
                    "field": "total_enrolments",
                    "type": "quantitative",
                    "title": "Enrolments",
                    "format": ","
                }
            ]
        }
    },
    "resolve": {
        "scale": {
            "y": "independent"
        }
    },
    "config": {
        "view": {
            "fill": null,
            "stroke": null
        },
        "axis": {
            "gridColor": "#E5DDD0",
            "gridOpacity": 0.6
        }
    }
}