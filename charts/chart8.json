{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "background": null,
    "width": 500,
    "height": 350,
    "data": {
        "url": "data/nsw_language_analysis_ready.csv",
        "format": {
            "type": "csv",
            "parse": {
                "year": "number",
                "enrolments": "number"
            }
        }
    },
    "params": [
        {
            "name": "school_selection",
            "value": "Secondary (Years 7–9)",
            "bind": {
                "input": "select",
                "options": [
                    "Primary",
                    "Secondary (Years 7–9)"
                ],
                "name": "School Level: "
            }
        }
    ],
    "transform": [
        {
            "filter": "datum.school_level === school_selection"
        },
        {
            "filter": {
                "field": "language",
                "oneOf": [
                    "Japanese",
                    "French",
                    "Chinese (Mandarin)",
                    "Italian",
                    "Spanish",
                    "Arabic"
                ]
            }
        },
        {
            "aggregate": [
                {
                    "op": "sum",
                    "field": "enrolments",
                    "as": "annual_enrolments"
                }
            ],
            "groupby": [
                "year",
                "language"
            ]
        }
    ],
    "mark": {
        "type": "boxplot",
        "extent": "min-max",
        "size": 35,
        "median": {
            "color": "#243B35"
        }
    },
    "encoding": {
        "y": {
            "field": "language",
            "type": "nominal",
            "title": null,
            "sort": [
                "Japanese",
                "French",
                "Chinese (Mandarin)",
                "Italian",
                "Spanish",
                "Arabic"
            ],
            "axis": {
                "labelFontSize": 12,
                "labelColor": "#5C6861"
            }
        },
        "x": {
            "field": "annual_enrolments",
            "type": "quantitative",
            "title": "Annual Language Enrolments",
            "scale": {
                "zero": true
            },
            "axis": {
                "format": "~s",
                "labelFontSize": 11,
                "labelColor": "#5C6861",
                "titleColor": "#5C6861",
                "gridColor": "#E5DDD0"
            }
        },
        "color": {
            "field": "language",
            "type": "nominal",
            "legend": null,
            "scale": {
                "domain": [
                    "Japanese",
                    "French",
                    "Chinese (Mandarin)",
                    "Italian",
                    "Spanish",
                    "Arabic"
                ],
                "range": [
                    "#E69F00",
                    "#9467BD",
                    "#0072B2",
                    "#555555",
                    "#CC79A7",
                    "#8C564B"
                ]
            }
        },
        "tooltip": [
            {
                "field": "language",
                "type": "nominal",
                "title": "Language"
            },
            {
                "field": "annual_enrolments",
                "type": "quantitative",
                "title": "Annual Enrolments",
                "format": ","
            }
        ]
    },
    "config": {
        "view": {
            "fill": null,
            "stroke": null
        }
    }
}